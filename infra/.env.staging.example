# Staging values. Copy to infra/.env on the staging host and never commit it.
# Fill every value from the controlled secret store; do not reuse local values.

POSTGRES_DB=jlu_dela_staging
POSTGRES_USER=jlu_dela
POSTGRES_PASSWORD=replace-with-a-url-safe-password
REDIS_PASSWORD=replace-with-another-url-safe-password

API_IMAGE=registry.example.edu.cn/jlu-dela/api@sha256:replace-me
APP_BUILD_ID=replace-with-source-commit
SITE_ADDRESS=workbench-staging.example.edu.cn
GIT_COMMIT=replace-with-source-commit

CORS_ALLOWED_ORIGINS=
DATABASE_MAX_CONNECTIONS=20
REQUEST_TIMEOUT_SECONDS=15
MAX_BODY_BYTES=1048576
FILE_MAX_BYTES=10485760
RUST_LOG=info,sqlx=warn

# Local development values. Copy to infra/.env and never commit the result.
# Passwords must be URL-safe because DATABASE_URL is assembled from them.

POSTGRES_DB=jlu_dela
POSTGRES_USER=jlu_dela
POSTGRES_PASSWORD=replace-with-a-url-safe-password
REDIS_PASSWORD=replace-with-another-url-safe-password

# The only host-published service in the default stack. Bound to loopback.
CADDY_PORT=8080
GIT_COMMIT=local
APP_BUILD_ID=local

# Comma-separated browser origins. Flutter desktop/mobile clients do not use CORS.
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

DATABASE_MAX_CONNECTIONS=10
REQUEST_TIMEOUT_SECONDS=15
MAX_BODY_BYTES=1048576
RUST_LOG=info,sqlx=warn

# Optional staging values. Leave unset for local development.
# API_IMAGE=registry.example.edu.cn/jlu-dela/api@sha256:replace-me
# SITE_ADDRESS=workbench-staging.example.edu.cn
